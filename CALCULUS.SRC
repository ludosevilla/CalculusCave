0,126,87,82,89,73,80,125,0,0,0,0,90,67,66,77,62,11,32,0,10};

// Ctrl + letter keys = ASCII 1 to 26; num 0 to 4 : ASCII 27 to 31
byte _gKeysCtrl[81]={0,28,30,0,0,0,0,127,0,0,0,0,3,1,4,7,10,12,0,0,
0,29,31,0,0,27,0,0,0,0,0,9,19,6,8,11,0,13,0,0,
0,17,5,20,21,15,0,0,0,0,0,0,24,22,14,0,0,8,0,9,
0,0,23,18,25,9,16,0,0,0,0,0,26,3,2,13,0,11,32,0,10};

// Fctn : 127 + keycode


byte _gSkey;
byte _gReadKeyUp;
byte _gReadKeyDwn;

byte getKey(bool willBlock) {
byte c;
byte k;

	while(true) {
		k=0;
		
		c=getKeyUp();
		if (c==51 || c==58) {
			_gSkey-=1; // Shift
		} else if (c==11) {
			_gSkey-=2; // Ctrl
		} else if (c==71) {
			_gSkey-=4; // Alt
		} else if (c==79) {
			_gSkey-=8; // Fctn
		}
		_gReadKeyUp=c;
		
		c=getKeyDwn();
		_gReadKeyDwn=c;
		
		if (c==0) {
			if (willBlock==false)
				return 0;
			continue;
		}
		
		if (c==51 || c==58) {
			_gSkey+=1; // Shift
			continue;
		} else if (c==11) {
			_gSkey+=2; // Ctrl
			continue;
		} else if (c==71) {
			_gSkey+=4; // Alt
			continue;
		} else if (c==79) {
			_gSkey+=8; // Fctn
			continue;
		}
		

		if (_gSkey==0)
			return _gKeys[c];
		if (_gSkey & 1)
			return _gKeysShift[c];
		if (_gSkey & 2)
			return _gKeysCtrl[c];
		if (_gSkey & 8)
			return c+127;
	}
	return 0;
}





void int2Txt(nat val,byte n) {
byte index;
byte i;

nat div=10;

	for(i=0;i<(n-2);i++) 
		div=div*10;
	for(i=0;i<n;i++) {
		index = 48+(byte)((val/div)%10);
		poke(&i2t+i,index);
		div/=10;
	}
	poke(&i2t+i,0);
}


void clearSprites() {
	for (byte i=0;i<32;i++) {
		sprPos(i,0,0);
		sprFlip(i,false,false);
		sprPrio(i,0);
	}
	sprUpdt();
}



void clearBitMap(){
	memSet(cpuWindow,48000,0,bmpPageA);
}


