bool showStats() {
byte c;
	poke(gfxModes,0b00000000);
	cls();
	if (lang==0) {
		import("res/notimefr.bmp",0x3000,48000,bmpPageA);
		import("res/notimefr.pal",bmpPal,48);	
		poke(gfxModes,0b00010001);
		curPos(53,16);
		print("2Partie terminee !");
		
		curPos(47,19);
		print("cTotal chauves-souris   : b",countBats);
		
		curPos(47,21);
		print("cBonnes reponses        : 9",right);
		
		curPos(47,23);
		print("cMauvaises reponses     : d",wrong);

		curPos(47,25);
		print("cChauves-souris ratees  : d",countBats-(wrong+right));

		curPos(47,28);
		print("2Tape une touche pour rejouer");
	} else {
		import("res/notimeen.bmp",0x3000,48000,bmpPageA);
		import("res/notimeen.pal",bmpPal,48);	
		poke(gfxModes,0b00010001);
		curPos(56,16);
		print("2Game over !");
		
		curPos(52,19);
		print("cTotal bats    : b",countBats);
		
		curPos(52,21);
		print("cRight answers : 9",right);
		
		curPos(52,23);
		print("cWrong answers : d",wrong);

		curPos(52,25);
		print("cMissed bats   : d",countBats-(wrong+right));

		curPos(47,28);
		print("2Press any key to play again");
	}
	sleep(2000);
	while(true) {
		c= _keyDwn;
		if (c==0) continue;
		sleep(300);
		poke(gfxModes,0b00000000);
		cls();
		clearBitMap();	
		if (c==12)
			return false;
		return true;
	}
	return true;
}
////////////////////////////////////////
////// MAIN FUNCTION
////////////////////////////////////////

void main() {
	
	// Starting
	bool stop=false;
	bool goRight=false;
	bool goLeft=false;

	import("/system/reginit.dat",0x1100,0);
	poke(gfxModes,0);
	cls();
	clearSprites();
	clearBitMap();	

	// Black background
	byte oldR=peek(0x2f13);
	byte oldG=peek(0x2f14);
	byte oldB=peek(0x2f15);
	poke(0x2f13,0);
	poke(0x2f14,0);
	poke(0x2f15,0);
	poke(statusReg,peek(0x2f0b)&0b01111111);// No mouse


	ymInit(0);
	ymVol(127);
	ymLoad("res/laser1.ins",0);
	ymVoice(0,0,3,0b11,127); // Player's laser
	ymVoice(1,0,1,0b11,127); // Alien shooting
	ymVoice(2,0,5,0b11,127); // Bonus
	
	synInit(0);
	synEnv(0,2,12,0,15);
	synVoice(0,2,1,0b11,15);
	

	// Started
	

	// Load sprites
	import("res/spr.spr",cpuWindow,0,sprPage);
	import("res/spr.pla",sprPlaA,48);
	import("res/spr.plb",sprPlaB,48);

	while(true) {
		stop=false;

		/////////////////////////
		////// Main Loop
		/////////////////////////

		showIntro();

		cls();
		poke(gfxModes,0);
		// Load background
		import("res/bg.bmp",0x3000,48000,bmpPageA);
		import("res/bg.pal",bmpPal,48);
		poke(gfxModes,0b00010101);


		sprNInit();
		sprAInit();
		sprPInit();
		initLevel();
		playerInit();
		batsInit();


		displayScore(true);
		oldTime=_time;
		
		while(!stop) {
			sprARun();
			sprPRun();
			batsLoop();

			vSync();
			sprUpdt();

			if (_keyDwn==12 || (time + maxTime)<=_time || nrj<=0 ) {
				stop=true;
				sleep(200);
				continue;
			}

			if (oldTime!=_time) {
				displayScore(false);
				oldTime=_time;
			}
			
			if (player.fireReady==1) {
				playerDigitReset();
				player.fireReady=2;
			}
			
			while(true) {
				c = getKeyUp();
				if (c==0) break;
				if (c==59) { // Right
					goRight=false;
				} else if (c==57) { // Left
					goLeft=false;
				}
			}

			if (_keyDwn==59) { // Right
				goRight=true;
			}
			if (_keyDwn==57) { // Left
				goLeft=true;
			}
			
			if (goRight) { // Right
				playerRight();
			}
			if (goLeft) { // Left
				playerLeft();
			}
			if (goRight || goLeft) {
				synNoteOff(0);
				synVoice(0,0,7,0b11,15);
				synEnv(0,0,10,0,0);
				synNoteOn(0,1,120);
			}
			
			if (_keyDwn==78) { // Spacebar
				playerFire();
			}
			
			if (player.fireReady==2) {
				c = getKey(false);

				if (c>=48 && c<=57) {
					playerSetDigit(c);
				}
				if (_gReadKeyUp==59) goRight=false;
				else if (_gReadKeyUp==57) goLeft=false;
			}
			
			// Collisions checks
			
			for(c=0;c<5;c++) {
				if (bats[c].ready==0) {

					if (player.fireReady==0) {
						// Bullet collide with bat?
						if (isSprSpr(bats[c].spId,28)) {
							byte r=rnd(0,9);
							if (bats[c].result == player.result) {
								sprAStartAlt(bats[c].spId,true);
								right++;
								curPos(58,38);
								if (lang==0) 
									print("9",bravoFR[r],"");
								else 
									print("9",bravoEN[r],"");
								ymNoteOn(2,10,127);
							} else {
								wrong++;
								curPos(58,38);
								if (lang==0) 
									print("d",missedFR[r],"");
								else 
									print("d",missedEN[r],"");
								nrj-=500;
								ymNoteOn(2,1,127);

							}
							displayScore(false);
							playerDigitReset();
							playerFireReset();
						}
					}
					// Player touch bat?
					if (isSprSpr(bats[c].spId,29)) {
						nrj-=500;
						sprAStartAlt(bats[c].spId,true);
						displayScore(false);
						synEnv(1,55,100,0,10);
						synVoice(1,1,3,0b11,15);
						synNoteOff(1);
						synNoteOn(1,60,127);
					}
				}
			}
		}
		stop=showStats();
		
		if (stop==false)
			break;
	}
	
	// Exiting

	clearSprites();
	clearBitMap();	
	cls();
			
	import("/system/reginit.dat",0x1100,0);
	
	poke(0x2f13,oldR);
	poke(0x2f14,oldG);
	poke(0x2f15,oldB);
	print("d                  e6e7e8e9eaebec93eeef");
	print("1Thanks for using  df6f7f8f9fafbfcfdfeff 1computer!");
	
}

// Start
main();


