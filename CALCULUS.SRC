/////////// MISC FUNCTIONS //////////////////
void cls() {
	memSet(0x1200,3200,32); //clear screen content
	memSet(0x1e80,3200,1); //clear screen colors
}

void sleep(nat msec) {
	clkSet();
	while(_mSec<msec){}
}

void pause(bool enable) {
	if (enable==true || _keyDwn == 66) {
		nat sec=_time;
		sleep(300);
		while(_keyDwn==0) {}
		sleep(150);
	}
}


