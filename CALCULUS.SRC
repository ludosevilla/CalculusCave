/////////////////
/// SELECT CHOICE FUNCTIONS ///
/////////////////

byte _selPosX[5];
byte _selPosY[5];
byte _selWidth[5]; // optional, width in chars
text _selTxt[5];
text _selTxtAttr[5];
byte _selLen;	// Max:5
byte _selColorSel;
byte _selColorUnsel;
nat _selX0prev;
nat _selX1prev;
nat _selY0prev;
nat _selY1prev;


void _selectSelect(byte n) {
nat x0;
nat y0;
nat x1;
nat y1;
byte l;
nat i;

	if (_selX0prev!=999) {
		rect(_selX0prev,_selY0prev,_selX1prev,_selY1prev,_selColorUnsel);
	}

	
	x0 = (_selPosX[n]*5)-2;
	y0 = (_selPosY[n]*6)-2;
	if (_selWidth[n]==0) {
		i=&_selTxt+(2*n);
		i=peekW(i);
		l=0;
		while(true) {
			byte j;
			j=peek(i);
			if (j==0) break;
			if (j>=32 && j<=126)
				l++;
			else if (j>=16 || j<=18) {
				l--;
			}
			i++;
		}	
		x1 = x0 + (l*5)+2;
	} else {
		x1 = x0 + (_selWidth[n]*5)+3;
	}
	y1 = y0 + 9;
	
	rect(x0,y0,x1,y1,_selColorSel);
	_selX0prev=x0;
	_selY0prev=y0;
	_selX1prev=x1;
	_selY1prev=y1;
}

byte selectRun() {
byte i;
byte sel;

	while(true) {
		i=getKeyDwn();
		if (i==0) break;
	}

	_selX0prev=999;
	for(i=0;i<_selLen;i++) {
		curPos(_selPosX[i],_selPosY[i]);
		//print(_selTxtAttr[i]);
		print(_selTxt[i]);
	}
	sel=0;
	_selectSelect(0);
	
	while(true) {
		i=getKeyDwn();
		if (i==80) {
			sel++;
			if (sel==_selLen) sel=0;
			_selectSelect(sel);

		} else if (i==77) {
			if (sel>0) sel--;
			else sel=_selLen-1;
			_selectSelect(sel);
		} else if (i==78 || i==37) {
			return sel;
		}
	}
	return 0;
}


